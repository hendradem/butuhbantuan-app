[Unit]
Description=ButuhBantuan Dashboard (Nuxt)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/butuhbantuan/dashboard
ExecStart=/usr/bin/node .output/server/index.mjs
EnvironmentFile=/opt/butuhbantuan/dashboard/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
